# Copie para .env e preencha:  cp .env.example .env

# Nome da loja (aparece na saudação)
STORE_NAME=Photocards K-pop

# ---------- Pagamento ----------
# mercadopago = Pix real | mock = Pix FALSO para testes (aprova sozinho)
PAYMENT_PROVIDER=mercadopago
# Só para PAYMENT_PROVIDER=mock: segundos até aprovar o Pix falso
MOCK_APPROVE_SECONDS=20
# Mercado Pago > Seu negócio > Configurações > Credenciais > Access Token
# (use o de TESTE para testar, e o de PRODUÇÃO para vender de verdade)
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxx
# E-mail enviado como "pagador" (o Mercado Pago exige um; pode ser o seu)
MP_PAYER_EMAIL=comprador@email.com
# Opcional: chave secreta do webhook (Mercado Pago > Suas integrações > Webhooks)
MP_WEBHOOK_SECRET=
# Validade do Pix, em minutos
PIX_EXPIRATION_MINUTES=30
# De quanto em quanto tempo o bot consulta os Pix pendentes (segundos)
PAYMENT_POLL_SECONDS=15

# ---------- Servidor / webhook (opcional) ----------
# Sem PUBLIC_URL o bot funciona só com a consulta periódica acima.
# Com PUBLIC_URL (ex.: https://meubot.exemplo.com) o Mercado Pago avisa na hora.
PORT=3000
PUBLIC_URL=

# ---------- WhatsApp ----------
# Deixe vazio para conectar por QR code. Ou coloque o número do bot (ex.: 5511999999999)
# para conectar por código de pareamento.
WHATSAPP_PAIRING_NUMBER=
# Números que recebem aviso a cada venda / pedido de atendente (separados por vírgula)
ADMIN_NUMBERS=

# ---------- Entrega ----------
# Pausa entre o envio de cada arquivo (ms) — evita bloqueio por envio em massa
DELAY_BETWEEN_FILES_MS=1500
# Quantas vezes o cliente pode pedir "reenviar" por pedido
MAX_RESENDS=3
